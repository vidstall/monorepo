{# Provisioned Grafana datasources, mounted straight into
   /etc/grafana/provisioning/datasources/datasource.yml. None of
   Prometheus/Tempo/Loki are guaranteed to colocate with Grafana -- three
   weak static hosts (bourbon/vermouth/baileys) can divide the stack up
   arbitrarily (see cli/observer/inventory.py's per-host services split).
   Find whichever host in the merged inventory actually runs each service
   (same groups['xaisen']/hostvars iteration prometheus.yml.j2 already uses
   to scrape the whole fleet from any observer host) and only fall back to
   the local container-name link when that host IS this one
   (inventory_hostname) -- otherwise reach it over the public network
   through that host's own observer-caddyfile.j2 site block, with
   credentials injected via Grafana datasource provisioning's
   jsonData/secureJsonData (the same xaisen_metrics_auth_token/
   xaisen_tempo_auth_token/xaisen_loki_auth_token every other metrics/log
   surface already uses, not new secrets).

   uid is pinned (not left to Grafana's auto-generated random default)
   because the dashboard JSON files under files/dashboards/ reference these
   datasources by this exact uid -- an unpinned uid would leave a
   dashboard's panels unable to resolve their datasource (a random uid every
   fresh provision, invisible until you check). #}
{% set xaisen_prometheus_host = namespace(name=None) %}
{% set xaisen_tempo_host = namespace(name=None) %}
{% set xaisen_loki_host = namespace(name=None) %}
{% for host in groups['xaisen'] %}
{% for svc in hostvars[host].get('xaisen_services', []) %}
{% if svc.service == 'prometheus' %}{% set xaisen_prometheus_host.name = host %}{% endif %}
{% if svc.service == 'tempo' %}{% set xaisen_tempo_host.name = host %}{% endif %}
{% if svc.service == 'loki' %}{% set xaisen_loki_host.name = host %}{% endif %}
{% endfor %}
{% endfor %}
apiVersion: 1

datasources:
  - name: Prometheus
    uid: Prometheus
    type: prometheus
    access: proxy
{% if xaisen_prometheus_host.name == inventory_hostname %}
    url: http://xaisen-prometheus:9090
{% else %}
    url: "https://prometheus-query.{{ hostvars[xaisen_prometheus_host.name].ansible_host | replace('.', '-') }}.sslip.io"
    jsonData:
      httpHeaderName1: "Authorization"
    secureJsonData:
      httpHeaderValue1: "Bearer {{ xaisen_metrics_auth_token }}"
{% endif %}
    isDefault: true
    editable: false
{% if xaisen_tempo_host.name %}
  - name: Tempo
    uid: Tempo
    type: tempo
    access: proxy
{% if xaisen_tempo_host.name == inventory_hostname %}
    url: http://xaisen-tempo:3200
{% else %}
    url: "https://tempo-query.{{ hostvars[xaisen_tempo_host.name].ansible_host | replace('.', '-') }}.sslip.io"
    jsonData:
      httpHeaderName1: "Authorization"
    secureJsonData:
      httpHeaderValue1: "Bearer {{ xaisen_tempo_auth_token }}"
{% endif %}
    editable: false
{% endif %}
{% if xaisen_loki_host.name %}
  - name: Loki
    uid: Loki
    type: loki
    access: proxy
{% if xaisen_loki_host.name == inventory_hostname %}
    url: http://xaisen-loki:3100
{% else %}
    url: "https://loki.{{ hostvars[xaisen_loki_host.name].ansible_host | replace('.', '-') }}.sslip.io"
    jsonData:
      basicAuth: true
      basicAuthUser: "xaisen"
    secureJsonData:
      basicAuthPassword: "{{ xaisen_loki_auth_token }}"
{% endif %}
    editable: false
{% endif %}
