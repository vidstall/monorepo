{# One site block per relay/signaling/bot/cp-daemon/validator-daemon
   instance colocated on this host. Hostname must exactly match what
   deploy_one_service.yml injects as RELAY_ENDPOINT_URL/ENDPOINT_URL
   (wss://<worker_key>.<ip-dashed>.sslip.io) or the cert Caddy obtains
   won't match what the client connects to. bot/cp-daemon/validator-daemon
   have no such env var -- their hostname is whatever sslip.io address is
   reached directly (bot's control API; cp-daemon/validator-daemon's
   metrics-only endpoint).

   The main upstream target is each app's FIXED internal listen port
   (WS_PORT for relay, SIGNALING_PORT for signaling, PORT for bot --
   see apps/relay/src/index.ts, apps/signaling/src/index.ts,
   apps/bot/src/config.ts, none read an env var keyed off worker_index),
   NOT svc.port -- that field is the per-worker_index-offset HOST-published
   port (cli/infra.py set_vm_defaults), which only matters for the
   docker_container ports: mapping. Caddy talks to the sibling container
   directly over the shared xaisen-net bridge, bypassing published host
   ports entirely, so every same-service replica on this host listens
   internally on the SAME fixed port and needs the SAME upstream target.
   cp-daemon/validator-daemon have NO such main surface at all (chain-
   facing daemons, not client-facing servers) -- they're absent from
   xaisen_internal_ports entirely, so their site block below only gets
   the metrics handle, no generic fallback.

   relay/signaling/bot/cp-daemon/validator-daemon each additionally run a
   SEPARATE metrics HTTP server on its own port (METRICS_PORT=4001,
   SIGNALING_METRICS_PORT=8083, BOT_METRICS_PORT=8096,
   CP_METRICS_PORT=8092, VALIDATOR_METRICS_PORT=8103 -- a distinct Node
   process listener, not the same server as the main port above) which has
   no published host port and no firewall rule of its own (see
   IaC/pulumi/app/compute/*.py's per-svc.port inbound rules) -- it's
   reachable ONLY by path-routing a slice of this SAME public hostname to
   that internal port, which is what xaisen_metrics_ports + the handle
   blocks below do. Prometheus's scrape targets go through this same
   public :443 hostname. /healthz* is NOT always on the same port as
   /metrics* -- only relay unifies both onto its metrics port (its own
   metrics-server.ts serves /healthz alongside /metrics, see RO-020).
   signaling/cp-daemon/validator-daemon each run startHealthzServer (see
   packages/shared/src/healthz.ts) as a SEPARATE node:http listener on its
   own *_HEALTHZ_PORT, distinct from its *_METRICS_PORT prom-metrics
   listener (which 404s on anything but /metrics) -- xaisen_healthz_ports
   below is that real per-service port, NOT a duplicate of
   xaisen_metrics_ports. bot has no healthz server at all, so it's absent
   from xaisen_healthz_ports and gets no /healthz* handle (confirmed via a
   live 404 from signaling's public hostname, caused by routing /healthz*
   at signaling's metrics port instead of its healthz port -- fixed here).
   This is what lets cp-daemon's relay-assignment liveness probe
   (room-assignment.ts) reach ANY candidate relay's health endpoint
   over the public hostname, regardless of whether cp-daemon happens to be
   colocated with that relay or on a different host entirely. /stats/*
   (the client's POST /stats/report), /logs/* (POST /logs/report), and
   /relay-down-hint* are relay's own app-protocol routes, not a generic
   metrics-server feature -- scoped to xaisen_stats_report_services so
   they aren't wrongly added for bot/cp-daemon/validator-daemon, which
   don't implement them. Without an explicit handle block here, a path
   falls through to the generic handle{} below and gets proxied to the
   WRONG port (the main WS/signaling port, not the metrics port these
   routes actually live on) -- confirmed missing for /logs/* and
   /relay-down-hint* before this comment was added. #}
{% set xaisen_internal_ports = {'relay': 4000, 'signaling': 8080, 'bot': 8095} %}
{% set xaisen_metrics_ports = {'relay': 4001, 'signaling': 8083, 'bot': 8096, 'cp-daemon': 8092, 'validator-daemon': 8103} %}
{% set xaisen_healthz_ports = {'relay': 4001, 'signaling': 8082, 'cp-daemon': 8091, 'validator-daemon': 8101} %}
{% set xaisen_stats_report_services = ['relay', 'signaling'] %}
{% for svc in xaisen_public_services %}
{{ svc.worker_key | default(svc.service) }}.{{ ansible_host | replace('.', '-') }}.sslip.io {
{% if svc.service in xaisen_metrics_ports %}
    handle /metrics* {
        reverse_proxy xaisen-{{ svc.worker_key | default(svc.service) }}:{{ xaisen_metrics_ports[svc.service] }}
    }
{% if svc.service in xaisen_healthz_ports %}
    handle /healthz* {
        reverse_proxy xaisen-{{ svc.worker_key | default(svc.service) }}:{{ xaisen_healthz_ports[svc.service] }}
    }
{% endif %}
{% if svc.service in xaisen_stats_report_services %}
    handle /stats/* {
        reverse_proxy xaisen-{{ svc.worker_key | default(svc.service) }}:{{ xaisen_metrics_ports[svc.service] }}
    }
    handle /logs/* {
        reverse_proxy xaisen-{{ svc.worker_key | default(svc.service) }}:{{ xaisen_metrics_ports[svc.service] }}
    }
    handle /relay-down-hint* {
        reverse_proxy xaisen-{{ svc.worker_key | default(svc.service) }}:{{ xaisen_metrics_ports[svc.service] }}
    }
{% endif %}
{% if svc.service in xaisen_internal_ports %}
    handle {
        reverse_proxy xaisen-{{ svc.worker_key | default(svc.service) }}:{{ xaisen_internal_ports[svc.service] }}
    }
{% endif %}
{% else %}
    reverse_proxy xaisen-{{ svc.worker_key | default(svc.service) }}:{{ xaisen_internal_ports[svc.service] }}
{% endif %}
}
{% endfor %}
