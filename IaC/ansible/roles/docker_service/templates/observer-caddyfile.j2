{# Bearer-token-gated public ingress for tempo's OTLP/HTTP receiver --
   tempo has no authentication of its own. Every relay/signaling/cp-daemon/
   validator-daemon VM in the fleet pushes spans here (see cli/infra's
   OTEL_EXPORTER_OTLP_ENDPOINT/HEADERS env injection), matching this SAME
   xaisen_tempo_auth_token (cli/observer/secrets.py's tempo_auth_token(),
   passed as the xaisen_tempo_auth_token extra var). Requests without a
   matching Authorization header get a plain 401, never reach tempo.

   Tempo's query API (3200) is deliberately NOT proxied here -- it stays
   loopback-only, reached by grafana (colocated on this same host, over the
   shared xaisen-net bridge by container name) or an SSH tunnel for direct
   debug access. Only the ingest path needs public reachability, since it's
   PUSHED to, unlike Prometheus/Tempo's query APIs which are PULLED from. #}
{% if xaisen_observer_tempo_service | length > 0 %}
tempo.{{ ansible_host | replace('.', '-') }}.sslip.io {
    @authorized {
        header Authorization "Bearer {{ xaisen_tempo_auth_token }}"
    }
    reverse_proxy @authorized xaisen-tempo:4318
    respond 401
}
{% endif %}

{# Grafana gets a plain reverse proxy, no bearer gate -- it has its own
   login screen (GF_SECURITY_ADMIN_PASSWORD, see cli/observer/secrets.py's
   grafana_admin_password()) guarding access, unlike tempo's auth-less
   OTLP receiver above. #}
{% if xaisen_observer_grafana_service | length > 0 %}
grafana.{{ ansible_host | replace('.', '-') }}.sslip.io {
    reverse_proxy xaisen-grafana:3000
}
{% endif %}

{# Pushgateway has no authentication of its own either -- same bearer gate
   as tempo above, reusing the SAME xaisen_metrics_auth_token every other
   metrics surface in this system already checks (not a separate token),
   since this is conceptually just another metrics-write path, not a
   distinct trust boundary. Eval-harness scripts running on a dev machine
   (scripts/eval/measure-onchain-cost.ts, measure-chain-latency.ts,
   run-scale-ramp.ts) PUT/POST their one-shot results here. Prometheus
   itself never uses this public route -- it scrapes xaisen-pushgateway
   directly over the internal xaisen-net bridge (see prometheus.yml.j2). #}
{% if xaisen_observer_pushgateway_service | length > 0 %}
pushgateway.{{ ansible_host | replace('.', '-') }}.sslip.io {
    @authorized {
        header Authorization "Bearer {{ xaisen_metrics_auth_token }}"
    }
    reverse_proxy @authorized xaisen-pushgateway:9091
    respond 401
}
{% endif %}

{# Loki's push API has no authentication of its own either, but unlike
   every other gated site block above this one matches on Basic Auth, not
   Bearer -- deliberately. Docker's native `loki` logging driver (used by
   EVERY container this role deploys, fleet-wide, to ship logs here -- see
   deploy_one_service.yml's log_driver/log_options) can only attach
   credentials via HTTP Basic Auth embedded in the loki-url's userinfo
   (https://xaisen:<token>@...); it has no way to send a custom
   Authorization: Bearer header the way OTEL exporters can. So this block
   compares against the literal Basic-Auth header value Docker's HTTP
   client will actually send, computed the same way (b64encode of
   "xaisen:<token>") -- do NOT "fix" this into a Bearer matcher like the
   other blocks; that would silently break every fleet container's log
   shipping. #}
{% if xaisen_observer_loki_service | length > 0 %}
loki.{{ ansible_host | replace('.', '-') }}.sslip.io {
    @authorized {
        header Authorization "Basic {{ ('xaisen:' ~ xaisen_loki_auth_token) | b64encode }}"
    }
    reverse_proxy @authorized xaisen-loki:3100
    respond 401
}
{% endif %}
