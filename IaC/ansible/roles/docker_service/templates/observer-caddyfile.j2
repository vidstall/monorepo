{# Bearer-token-gated public ingress for tempo's OTLP/HTTP receiver --
   tempo has no authentication of its own. Every relay/signaling/cp-daemon/
   validator-daemon VM in the fleet pushes spans here (see cli/infra's
   OTEL_EXPORTER_OTLP_ENDPOINT/HEADERS env injection), matching this SAME
   xaisen_tempo_auth_token (cli/observer/secrets.py's tempo_auth_token(),
   passed as the xaisen_tempo_auth_token extra var). Requests without a
   matching Authorization header get a plain 401, never reach tempo.

   Tempo's query API (3200) is proxied separately below (a distinct
   hostname, "tempo-query"), not here -- this block is ingest-only.

   Every gated block below wraps reverse_proxy+respond in an explicit
   `route {}`: Caddy does NOT execute same-level directives in the order
   they're written, it sorts them by a fixed built-in directive priority
   list, and `respond` sorts before `reverse_proxy` regardless of source
   order. Without `route {}` the unconditional `respond 401` always wins
   and the auth-gated reverse_proxy is dead code -- every request 401s
   even with a correct token. This bit us in production: found via a live
   401 on pushgateway/tempo-query with a byte-verified matching token. #}
{% if xaisen_observer_tempo_service | length > 0 %}
tempo.{{ ansible_host | replace('.', '-') }}.sslip.io {
    @authorized {
        header Authorization "Bearer {{ xaisen_tempo_auth_token }}"
    }
    route {
        reverse_proxy @authorized xaisen-tempo:4318
        respond 401
    }
}
{% endif %}

{# Tempo's QUERY API (3200), bearer-gated the SAME way as the OTLP ingest
   block above (reusing xaisen_tempo_auth_token, not a separate token --
   same trust boundary, just a different Tempo endpoint). Needed whenever
   Grafana doesn't colocate with Tempo on the same host (e.g. bourbon/
   vermouth dividing the monitoring stack between two weak hosts) -- Grafana's
   datasource then reaches Tempo over the public network instead of the
   xaisen-net bridge by container name (see grafana-datasource.yml.j2), so
   this must be reachable from off-box. Distinct hostname ("tempo-query", not
   "tempo") since it's a different site block for a different upstream port,
   sharing this host's one IP the same way relay/signaling share a droplet
   via worker_key-prefixed hostnames. Still SSH-tunnel-reachable too when
   Tempo IS colocated with grafana; rendering it unconditionally whenever
   tempo is present costs nothing extra. #}
{% if xaisen_observer_tempo_service | length > 0 %}
tempo-query.{{ ansible_host | replace('.', '-') }}.sslip.io {
    @authorized {
        header Authorization "Bearer {{ xaisen_tempo_auth_token }}"
    }
    route {
        reverse_proxy @authorized xaisen-tempo:3200
        respond 401
    }
}
{% endif %}

{# Grafana gets a plain reverse proxy, no bearer gate -- it has its own
   login screen (GF_SECURITY_ADMIN_PASSWORD, see cli/observer/secrets.py's
   grafana_admin_password()) guarding access, unlike tempo's auth-less
   OTLP receiver above. #}
{% if xaisen_observer_grafana_service | length > 0 %}
grafana.{{ ansible_host | replace('.', '-') }}.sslip.io {
    reverse_proxy xaisen-grafana:3000
}
{% endif %}

{# Pushgateway has no authentication of its own either -- same bearer gate
   as tempo above, reusing the SAME xaisen_metrics_auth_token every other
   metrics surface in this system already checks (not a separate token),
   since this is conceptually just another metrics-write path, not a
   distinct trust boundary. Eval-harness scripts running on a dev machine
   (scripts/eval/measure-onchain-cost.ts, measure-chain-latency.ts,
   run-scale-ramp.ts) PUT/POST their one-shot results here. Prometheus
   itself never uses this public route -- it scrapes xaisen-pushgateway
   directly over the internal xaisen-net bridge (see prometheus.yml.j2).

   Also the landing zone for the browser client's testbed-only direct
   call-quality push (services/client/client/src/lib/metrics-push.ts),
   PUT straight from the page's own origin -- unlike the eval-harness
   scripts above, a browser PUT with a custom Authorization header
   triggers a CORS preflight, so this block needs the SAME
   preflight-bypass + response-header treatment loki's push API gets
   below (bearer, not basic, since fetch() can set a real Authorization
   header, unlike Docker's log driver). #}
{% if xaisen_observer_pushgateway_service | length > 0 %}
pushgateway.{{ ansible_host | replace('.', '-') }}.sslip.io {
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, PUT, POST, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Authorization, Content-Type"
    }
    @cors_preflight {
        method OPTIONS
    }
    @authorized {
        header Authorization "Bearer {{ xaisen_metrics_auth_token }}"
    }
    route {
        respond @cors_preflight 204
        reverse_proxy @authorized xaisen-pushgateway:9091
        respond 401
    }
}
{% endif %}

{# Loki's push API has no authentication of its own either, but unlike
   every other gated site block above this one matches on Basic Auth, not
   Bearer -- deliberately. Docker's native `loki` logging driver (used by
   EVERY container this role deploys, fleet-wide, to ship logs here -- see
   deploy_one_service.yml's log_driver/log_options) can only attach
   credentials via HTTP Basic Auth embedded in the loki-url's userinfo
   (https://xaisen:<token>@...); it has no way to send a custom
   Authorization: Bearer header the way OTEL exporters can. So this block
   compares against the literal Basic-Auth header value Docker's HTTP
   client will actually send, computed the same way (b64encode of
   "xaisen:<token>") -- do NOT "fix" this into a Bearer matcher like the
   other blocks; that would silently break every fleet container's log
   shipping. #}
{% if xaisen_observer_loki_service | length > 0 %}
loki.{{ ansible_host | replace('.', '-') }}.sslip.io {
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, OPTIONS"
        Access-Control-Allow-Headers "Authorization, Content-Type"
    }
    @cors_preflight {
        method OPTIONS
    }
    @authorized {
        header Authorization "Basic {{ ('xaisen:' ~ xaisen_loki_auth_token) | b64encode }}"
    }
    route {
        respond @cors_preflight 204
        reverse_proxy @authorized xaisen-loki:3100
        respond 401
    }
}
{% endif %}

{# Prometheus's QUERY API (/api/v1/query etc, its normal internal port 9090 --
   NOT the operator-chosen host_port used for the loopback/SSH-tunnel path),
   bearer-gated the same way as pushgateway above (reusing
   xaisen_metrics_auth_token, not a separate token -- same trust boundary,
   just a read path this time instead of a write path). Needed by the GUI's
   Room tab (cli/gui/pages/scenario_page/room.py) to read live
   dvconf_room_participants values from an operator's machine, which has no
   other way to reach Prometheus's loopback-only port (see
   cli/observer/inventory.py's port comments -- direct query access was
   previously SSH-tunnel-only, same as tempo's query API before tempo-query
   above existed). Distinct hostname ("prometheus-query") since it's a
   different site block for a different service than pushgateway/tempo. #}
{% if xaisen_observer_prometheus_service | length > 0 %}
prometheus-query.{{ ansible_host | replace('.', '-') }}.sslip.io {
    @authorized {
        header Authorization "Bearer {{ xaisen_metrics_auth_token }}"
    }
    route {
        reverse_proxy @authorized xaisen-prometheus:9090
        respond 401
    }
}
{% endif %}
