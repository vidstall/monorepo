{# Fleet-wide scrape config for the singleton Prometheus worker. Iterates
   every host in the play's inventory group (not just this host -- Ansible
   makes hostvars for the whole group available regardless of --limit),
   collecting each host's xaisen_services list (same structure
   deploy_one_service.yml loops over) and emitting one scrape target per
   instance's PUBLIC sslip.io endpoint (the same Caddy-fronted hostname
   RELAY_ENDPOINT_URL/ENDPOINT_URL already use for relay/signaling -- see
   Caddyfile.j2). There is no private network between droplets, so
   scraping happens over the public HTTPS endpoint, gated by the same
   METRICS_AUTH_TOKEN bearer credential every worker's /metrics(/prom)
   route checks. cp-daemon/validator-daemon/bot all use the shared
   packages/shared/src/metrics-prom.ts helper (plain GET /metrics, same as
   signaling), unlike relay's own hand-rolled /metrics/prom server.

   One HOSTNAME per host now (path-based Caddy routing, see Caddyfile.j2),
   not one per worker -- so `metrics_path` can no longer be a single
   job-level value shared by every target in a job (different workers on
   different hosts need different `/<provider>-<host>/<service>-<index>/
   metrics` paths). Each target below instead sets its OWN __metrics_path__
   meta-label directly in that target's `labels:` block -- Prometheus reads
   __metrics_path__/__scheme__/__address__ as first-class per-target
   overrides without needing an explicit relabel_configs step, so this is
   the standard way to vary the scrape path per static target. #}
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: xaisen
    scheme: https
    authorization:
      credentials: "{{ xaisen_metrics_auth_token }}"
    static_configs:
{% for host in groups['xaisen'] %}
{% for svc in hostvars[host].get('xaisen_services', []) %}
{% if svc.service == 'relay' %}
      - targets: ["{{ hostvars[host].ansible_host | replace('.', '-') }}.sslip.io:443"]
        labels:
          __metrics_path__: /{{ hostvars[host].xaisen_provider }}-{{ hostvars[host].xaisen_host }}/{{ svc.service }}-{{ svc.index }}/metrics/prom
{% endif %}
{% endfor %}
{% endfor %}
  - job_name: xaisen-cp-daemon
    scheme: https
    authorization:
      credentials: "{{ xaisen_metrics_auth_token }}"
    static_configs:
{% for host in groups['xaisen'] %}
{% for svc in hostvars[host].get('xaisen_services', []) %}
{% if svc.service == 'cp-daemon' %}
      - targets: ["{{ hostvars[host].ansible_host | replace('.', '-') }}.sslip.io:443"]
        labels:
          __metrics_path__: /{{ hostvars[host].xaisen_provider }}-{{ hostvars[host].xaisen_host }}/{{ svc.service }}-{{ svc.index }}/metrics
{% endif %}
{% endfor %}
{% endfor %}
  - job_name: xaisen-validator-daemon
    scheme: https
    authorization:
      credentials: "{{ xaisen_metrics_auth_token }}"
    static_configs:
{% for host in groups['xaisen'] %}
{% for svc in hostvars[host].get('xaisen_services', []) %}
{% if svc.service == 'validator-daemon' %}
      - targets: ["{{ hostvars[host].ansible_host | replace('.', '-') }}.sslip.io:443"]
        labels:
          __metrics_path__: /{{ hostvars[host].xaisen_provider }}-{{ hostvars[host].xaisen_host }}/{{ svc.service }}-{{ svc.index }}/metrics
{% endif %}
{% endfor %}
{% endfor %}
  - job_name: xaisen-bot
    scheme: https
    authorization:
      credentials: "{{ xaisen_metrics_auth_token }}"
    static_configs:
{% for host in groups['xaisen'] %}
{% for svc in hostvars[host].get('xaisen_services', []) %}
{% if svc.service == 'bot' %}
      - targets: ["{{ hostvars[host].ansible_host | replace('.', '-') }}.sslip.io:443"]
        labels:
          __metrics_path__: /{{ hostvars[host].xaisen_provider }}-{{ hostvars[host].xaisen_host }}/{{ svc.service }}-{{ svc.index }}/metrics
{% endif %}
{% endfor %}
{% endfor %}
  # node_exporter runs on every worker droplet (one per host, auto-injected
  # by cli/scenario/spec.py's load_scenario() -- see PINNED_IMAGES), never
  # colocated with Prometheus like pushgateway below. It has no TLS/Caddy
  # front door of its own (unlike the bearer-gated jobs above, which reverse
  # -proxy through each droplet's Caddy sidecar) and no auth -- scraped
  # directly over plain HTTP on its published public port. One target per
  # HOST (not per xaisen_services entry -- node_exporter reports on the
  # whole machine, so de-dup by host to avoid one duplicate target per
  # colocated daemon sharing that droplet).
  - job_name: xaisen-node-exporter
    static_configs:
      - targets:
{% for host in groups['xaisen'] %}
{% set ne = hostvars[host].get('xaisen_services', []) | selectattr('service', 'equalto', 'node_exporter') | list %}
{% if ne %}
          - "{{ ne[0].worker_key | default(ne[0].service) }}.{{ hostvars[host].ansible_host | replace('.', '-') }}.sslip.io:9100"
{% endif %}
{% endfor %}
  # Pushgateway is colocated on THIS SAME observer host (see
  # cli/observer/inventory.py's _host_entry()), reachable directly over the
  # internal xaisen-net bridge by container name -- no public hostname/
  # bearer-token dance needed here, unlike the fleet-wide jobs above (this
  # template renders once per observer host, so "this host's own
  # xaisen-pushgateway" is always the right, and only, target).
  # honor_labels keeps whatever job/instance labels the pushing client set
  # (e.g. scripts/eval/measure-onchain-cost.ts) instead of Prometheus
  # overwriting them with this scrape target's own -- the standard
  # Pushgateway scrape convention.
  - job_name: xaisen-pushgateway
    honor_labels: true
    static_configs:
      - targets:
          - "xaisen-pushgateway:9091"
{% if xaisen_coturn_targets %}
  # Monitoring-redesign gap #7 (scoped down): coturn's native Prometheus
  # listener (bootstrap-vm.sh's configure_coturn_metrics, port 9641). coturn
  # is NOT part of the xaisen fleet above -- it runs on a separately
  # provisioned VM, so this is a plain static list (xaisen_coturn_targets,
  # default [] -> this whole job is omitted) rather than a groups['xaisen']
  # loop. Plain HTTP, no bearer auth (coturn's built-in exporter has none).
  - job_name: coturn
    static_configs:
      - targets:
{% for target in xaisen_coturn_targets %}
          - "{{ target }}"
{% endfor %}
{% endif %}
