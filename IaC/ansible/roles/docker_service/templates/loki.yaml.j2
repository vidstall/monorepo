{# Single-binary Loki config for the singleton monitoring host. No
   auth of its own (see observer-caddyfile.j2's Basic-Auth-gated reverse
   proxy in front of the push API, and deploy_one_service.yml's
   loopback-only ports: mapping) -- local disk storage only, no S3/GCS
   backend needed at this scale. retention_period below is deliberately
   short, matching tempo's block_retention: this is a thesis-scale single
   box the operator manages themselves, not a production long-term log
   archive. #}
auth_enabled: false

server:
  http_listen_port: 3100

common:
  path_prefix: /var/loki
  storage:
    filesystem:
      chunks_directory: /var/loki/chunks
      rules_directory: /var/loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

limits_config:
  retention_period: 72h
  allow_structured_metadata: true
