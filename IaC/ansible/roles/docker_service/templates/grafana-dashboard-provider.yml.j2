{# Grafana file-based dashboard provider -- mounted into
   /etc/grafana/provisioning/dashboards/dashboard-provider.yml, parallel to
   grafana-datasource.yml.j2's datasource provider. Points Grafana at a
   folder (options.path) that the whole files/dashboards/ directory is
   bind-mounted into wholesale (see deploy_one_service.yml's grafana volume
   list) -- Grafana polls that folder every updateIntervalSeconds and
   loads/reloads any dashboard JSON it finds there. #}
apiVersion: 1

providers:
  - name: xaisen
    folder: Xaisen
    type: file
    disableDeletion: false
    updateIntervalSeconds: 30
    options:
      path: /etc/grafana/provisioning/dashboards/xaisen
