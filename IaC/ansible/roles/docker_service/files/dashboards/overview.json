{
  "uid": "overview",
  "title": "Overview",
  "tags": [
    "xaisen"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "annotations": {
    "list": [
      {
        "name": "Worker start/stop",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "red",
        "tags": ["worker-churn"],
        "type": "tags"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Contract & Chain",
      "type": "link",
      "url": "/d/contract-chain/contract-chain",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Infrastructure",
      "type": "link",
      "url": "/d/infrastructure/infrastructure",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Workers",
      "type": "link",
      "url": "/d/workers/workers",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Rooms",
      "type": "link",
      "url": "/d/rooms/rooms",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "User",
      "type": "link",
      "url": "/d/peer-quality/peer-quality",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 2,
      "type": "stat",
      "title": "Targets up",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "up{job=~\"xaisen.*\"}",
          "instant": true,
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Active sessions / rooms",
      "description": "dvconf_active_sessions (relay/signaling/bot concurrency gauge) and dvconf_rooms_active (signaling) -- packages/shared/src/metrics-prom.ts, apps/signaling/src/index.ts.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "dvconf_active_sessions",
          "legendFormat": "sessions ({{job}})",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "dvconf_rooms_active",
          "legendFormat": "rooms active",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Chain consensus activity",
      "description": "dvconf_role_votes_cast_total (cp-daemon vote submissions) and dvconf_role_assignments_total (completed apply_voted_role calls) -- role_voting.move / registration.move.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "rate(dvconf_role_votes_cast_total[5m])",
          "legendFormat": "votes cast/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "rate(dvconf_role_assignments_total[5m])",
          "legendFormat": "assignments/s ({{service}})",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Recent errors (fleet-wide)",
      "description": "Every container's stdout/stderr, fleet-wide, via Docker's loki logging driver (see deploy_one_service.yml's log_driver/log_options) -- filtered to error-looking lines. service/worker/host labels come from that same log_options' loki-external-labels.",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{service=~\".+\"} |~ \"(?i)error|fail|exception\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Liveness",
      "description": "Fault-tolerance experiment table: `vidctl utils worker stop/start` ground-truth timestamps joined against relay client-awareness (dvconf_relay_down_hint_*) and validator worker-awareness (dvconf_worker_down_vote_total) -- see cli/observer/worker_liveness.py (the correlator that computes and pushes these xaisen_worker_liveness_* rows; run `vidctl observer worker-liveness` or `--watch` to keep it fresh). Columns 3+ are seconds elapsed since column 1 (Stop time), not absolute timestamps.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "xaisen_worker_liveness_stopped_at_seconds * 1000",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "xaisen_worker_liveness_downtime_seconds",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "xaisen_worker_liveness_first_client_awareness_seconds",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "xaisen_worker_liveness_client_awareness_count",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "xaisen_worker_liveness_worker_awareness_count",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "E"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "event_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "event_id": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true
            },
            "indexByName": {},
            "renameByName": {
              "worker": "Worker",
              "relay": "Relay Instance",
              "Value #A": "Stop Time",
              "Value #B": "Downtime (s)",
              "Value #C": "First Client Awareness (s)",
              "Value #D": "Client Awareness Count",
              "Value #E": "Worker Awareness Count"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Stop Time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Downtime (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "First Client Awareness (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Stop Time",
            "desc": true
          }
        ]
      }
    }
  ]
}