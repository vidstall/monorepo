          "expr": "max(dvconf_relay_peer_ice_success{roomId=~\"$room\"}) by (roomId)",
          "legendFormat": "max {{roomId}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Packet Reordering Rate (All Users)",
      "description": "dvconf_relay_peer_packet_reordering_rate{roomId,peerId} -- apps/relay/src/metrics-server.ts, aggregated (avg/min/max) across all peers currently in the room. A jitterBufferDelay-per-emitted-frame ratio, in ms -- not a percentage, split out from the old combined Packet Loss & Reordering panel so it no longer shares an axis with the 0-100 packet-loss percentage.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 62
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "avg(dvconf_relay_peer_packet_reordering_rate{roomId=~\"$room\"}) by (roomId)",
          "legendFormat": "reordering avg {{roomId}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "min(dvconf_relay_peer_packet_reordering_rate{roomId=~\"$room\"}) by (roomId)",
          "legendFormat": "reordering min {{roomId}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "max(dvconf_relay_peer_packet_reordering_rate{roomId=~\"$room\"}) by (roomId)",
          "legendFormat": "reordering max {{roomId}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 17,
      "type": "table",
      "title": "Relay Failover Downtime (All Users)",
      "description": "Cross-user aggregation of the same per-event cutover log used by the User dashboard's Relay Failover Downtime table, grouped by (dead relay, switch-to relay) since independently-reporting peers share no cutover-event id -- if the same relay pair fails over twice within the panel's time window, those instances collapse into one aggregated row. Shows the AVERAGE event timestamp and AVERAGE downtime duration across every user who reported that failover, computed via LogQL's avg_over_time range-aggregation with `| unwrap` on the context_downtimeMs / context_eventEpochMs fields Loki's `| json` auto-flattens out of the client's structured log context.",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 70
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "avg_over_time({service=\"client\"} | json | module=\"webrtc/useRelay\" | message=~\"Primary relay dropped.*\" | roomId=~\"$room\" | unwrap context_downtimeMs [$__range]) by (context_deadRelayUrl, context_url)",
          "queryType": "instant",
          "instant": true,
          "refId": "A",
          "legendFormat": "{{context_deadRelayUrl}} -> {{context_url}}"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "avg_over_time({service=\"client\"} | json | module=\"webrtc/useRelay\" | message=~\"Primary relay dropped.*\" | roomId=~\"$room\" | unwrap context_eventEpochMs [$__range]) by (context_deadRelayUrl, context_url)",
          "queryType": "instant",
          "instant": true,
          "refId": "B",
          "legendFormat": "{{context_deadRelayUrl}} -> {{context_url}}"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "context_deadRelayUrl": 0,
              "context_url": 1,
              "Value #B": 2,
              "Value #A": 3
            },
            "renameByName": {
              "context_deadRelayUrl": "dead relay",
              "context_url": "switch-to relay",
              "Value #B": "timestamp",
              "Value #A": "downtime"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "downtime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "timestamp"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      }
    }
  ]
}
