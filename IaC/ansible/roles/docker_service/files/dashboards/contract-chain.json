{
  "uid": "contract-chain",
  "title": "Contract & Chain",
  "tags": [
    "xaisen"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 15,
      "type": "row",
      "title": "Snapshot freshness (pushgateway \u2014 everything below is only as fresh as this)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Contract-state data freshness",
      "description": "Seconds since the last `vidctl observer export-contract-state` push -- push_time_seconds is Pushgateway's own built-in per-job/instance metric, no extra instrumentation needed. Every OTHER panel on this dashboard is only as fresh as this value.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "time() - push_time_seconds{job=\"contract_state\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Contract status (snapshot)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Contract published",
      "description": "dvconf_contract_published -- 1 if CONTRACT_PACKAGE_ID is set for the active env, else 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "dvconf_contract_published",
          "legendFormat": "{{env}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT PUBLISHED",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "PUBLISHED",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Contract package & chain identity",
      "description": "dvconf_contract_package_info{package_id,chain_id} -- already collected by export-contract-state, just never had a panel showing it before.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "dvconf_contract_package_info",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "type": "row",
      "title": "On-chain registration vs wallet pool (snapshot)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Wallet pool by role x status",
      "description": "dvconf_wallet_pool_count{role,status} -- free/assigned/retired wallets per role, from cli.wallet.pool_status().",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "dvconf_wallet_pool_count",
          "legendFormat": "{{role}} ({{status}})",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "On-chain registered miners by role",
      "description": "dvconf_onchain_registered_count{role} -- MinerStore's per-role VecSet sizes (cp_miners/relay_miners/validator_miners/user_miners), same read this session used to diagnose the quorum-inflation bug.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "dvconf_onchain_registered_count",
          "legendFormat": "{{role}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Wallet pool detail",
      "description": "dvconf_wallet_pool_count{role,status} as a table -- easier to scan exact counts than the pie chart above.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "dvconf_wallet_pool_count",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Registered users (UserRegistry)",
      "description": "dvconf_registered_users_total -- UserRegistry.total_users, incremented by user_registry::register_user() (the same field services/client/client/src/hooks/useNetworkStats.ts reads via devInspect for the lobby's \"Users\" tile). Distinct from On-chain registered miners by role's user=0 (that one is MinerStore.user_miners, a miner-role bucket no client code ever registers into).",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "dvconf_registered_users_total",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Wallet pool (assigned) vs on-chain registered, by role",
      "description": "dvconf_wallet_pool_count{status=\"assigned\"} vs dvconf_onchain_registered_count -- a persistent gap between the two for the same role means onboarding is stuck (wallet checked out and assigned, but never made it on-chain).",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "dvconf_wallet_pool_count{status=\"assigned\"}",
          "legendFormat": "assigned {{role}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "dvconf_onchain_registered_count",
          "legendFormat": "registered {{role}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 18,
      "type": "row",
      "title": "Voting",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Role-vote-cast rate vs. 2/3 quorum threshold",
      "description": "dvconf_role_votes_cast_total and dvconf_role_assignments_total -- role_voting.move requires a 2/3 CP supermajority (base_threshold_bps = 6667). The dashed line is illustrative context, not a literal vote-count threshold (quorum is a FRACTION of active CPs, not a fixed count).",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "rate(dvconf_role_votes_cast_total[5m])",
          "legendFormat": "votes cast/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "rate(dvconf_role_assignments_total[5m])",
          "legendFormat": "assignments/s ({{service}})",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.6667
              }
            ]
          }
        }
      }
    },
    {
      "id": 19,
      "type": "row",
      "title": "Live fleet health (continuously scraped)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 55
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Active rooms",
      "description": "dvconf_rooms_active (cp-daemon) -- same continuously-scraped metric as the Overview dashboard's \"Active sessions / rooms\" panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(dvconf_rooms_active)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Active workers (fleet-wide)",
      "description": "count(up == 1) across every fleet worker job (relay/cp-daemon/validator-daemon/bot) -- excludes node_exporter/pushgateway, which aren't miner-role workers.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "count(up{job=~\"xaisen|xaisen-cp-daemon|xaisen-validator-daemon|xaisen-bot\"} == 1)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Workers per role",
      "description": "sum(up) by (job) across every fleet worker job -- how many relay/cp-daemon/validator-daemon/bot instances are currently reachable.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(up{job=~\"xaisen|xaisen-cp-daemon|xaisen-validator-daemon|xaisen-bot\"}) by (job)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Errors",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 72
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Registration / voting errors (fleet-wide)",
      "description": "Every registering/voting role's stdout/stderr via Docker's loki logging driver (see deploy_one_service.yml's log_driver/log_options), filtered to error-looking lines and known on-chain registration/voting error codes (E_ALREADY_REGISTERED, E_NOT_RELAY) -- shows WHY onboarding/voting is stuck, not just that a count isn't moving.",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "x": 0,
        "y": 73,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{service=~\"relay|cp-daemon|validator-daemon\"} |~ \"(?i)error|fail|exception|E_ALREADY_REGISTERED|E_NOT_RELAY\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}