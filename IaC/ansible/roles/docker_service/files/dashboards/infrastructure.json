{
  "uid": "infrastructure",
  "title": "Infrastructure",
  "tags": ["xaisen"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-5m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "query": { "query": "label_values(node_uname_info, instance)", "refId": "hostVariable" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "node_exporter targets up",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "up{job=\"xaisen-node-exporter\", instance=~\"$host\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU usage per droplet",
      "description": "1 - idle-rate, node_exporter's standard CPU-busy derivation.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\", instance=~\"$host\"}[5m]))", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory available",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_memory_MemAvailable_bytes{instance=~\"$host\"}", "legendFormat": "available {{instance}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_memory_MemTotal_bytes{instance=~\"$host\"}", "legendFormat": "total {{instance}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network throughput",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(node_network_receive_bytes_total{instance=~\"$host\", device!=\"lo\"}[5m])", "legendFormat": "rx {{instance}}/{{device}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(node_network_transmit_bytes_total{instance=~\"$host\", device!=\"lo\"}[5m])", "legendFormat": "tx {{instance}}/{{device}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Disk space available",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_filesystem_avail_bytes{instance=~\"$host\", fstype!~\"tmpfs|overlay\"}", "legendFormat": "{{instance}}/{{mountpoint}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Load average",
      "description": "node_load1/5/15 -- saturation signal beyond raw CPU%, since a busy-but-not-100%-CPU host can still be queueing work.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_load1{instance=~\"$host\"}", "legendFormat": "1m {{instance}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_load5{instance=~\"$host\"}", "legendFormat": "5m {{instance}}", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_load15{instance=~\"$host\"}", "legendFormat": "15m {{instance}}", "refId": "C" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Filesystem used %",
      "description": "1 - (avail/size) -- easier to read/alert on at a glance than the raw-bytes-available panel above (which stays, for exact-size detail).",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "1 - (node_filesystem_avail_bytes{instance=~\"$host\", fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{instance=~\"$host\", fstype!~\"tmpfs|overlay\"})", "legendFormat": "{{instance}}/{{mountpoint}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 } }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Host uptime",
      "description": "time() - node_boot_time_seconds -- surfaces a silent VM reboot, a distinct failure mode from a container restart that nothing else on this dashboard detects.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 30 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "time() - node_boot_time_seconds{instance=~\"$host\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Open file descriptors / TCP sockets",
      "description": "node_filefd_allocated and node_sockstat_TCP_alloc -- relay under heavy WebRTC/TCP load can hit fd/socket exhaustion before CPU/memory look stressed at all.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_filefd_allocated{instance=~\"$host\"}", "legendFormat": "fds {{instance}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_sockstat_TCP_alloc{instance=~\"$host\"}", "legendFormat": "tcp sockets {{instance}}", "refId": "B" }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "coturn scrape up",
      "description": "Monitoring-redesign gap #7 (scoped down): coturn is NOT part of the $host-templated xaisen fleet above -- it runs on a separately, manually provisioned VM (see bootstrap-vm.sh's configure_coturn_metrics + xaisen_coturn_targets). No $host filter (that variable is sourced from node_uname_info, which this VM never reports).",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 38 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "up{job=\"coturn\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "PSI pressure (cpu/memory/io) + OOM kills",
      "description": "node_pressure_{cpu,memory,io}_waiting_seconds_total and node_pressure_memory_stalled_seconds_total (Linux PSI, rate x100 = % of time stalled) plus node_vmstat_oom_kill -- surfaces saturation that raw CPU%/load-avg can miss, and outright OOM-kill events.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "100 * rate(node_pressure_cpu_waiting_seconds_total{instance=~\"$host\"}[5m])", "legendFormat": "cpu some {{instance}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "100 * rate(node_pressure_memory_waiting_seconds_total{instance=~\"$host\"}[5m])", "legendFormat": "memory some {{instance}}", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "100 * rate(node_pressure_memory_stalled_seconds_total{instance=~\"$host\"}[5m])", "legendFormat": "memory full {{instance}}", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "100 * rate(node_pressure_io_waiting_seconds_total{instance=~\"$host\"}[5m])", "legendFormat": "io some {{instance}}", "refId": "D" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(node_vmstat_oom_kill{instance=~\"$host\"}[5m])", "legendFormat": "oom kills/s {{instance}}", "refId": "E" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Disk I/O throughput",
      "description": "node_disk_{read,written}_bytes_total -- per-device disk throughput, distinct from the filesystem-space panels above.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(node_disk_read_bytes_total{instance=~\"$host\"}[5m])", "legendFormat": "read {{instance}}/{{device}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(node_disk_written_bytes_total{instance=~\"$host\"}[5m])", "legendFormat": "write {{instance}}/{{device}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Network errors + drops",
      "description": "node_network_{receive,transmit}_{errs,drop}_total -- distinct from the throughput panel above; a healthy-looking throughput graph can still hide a rising error/drop rate.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(node_network_receive_errs_total{instance=~\"$host\", device!=\"lo\"}[5m])", "legendFormat": "rx errs {{instance}}/{{device}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(node_network_transmit_errs_total{instance=~\"$host\", device!=\"lo\"}[5m])", "legendFormat": "tx errs {{instance}}/{{device}}", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(node_network_receive_drop_total{instance=~\"$host\", device!=\"lo\"}[5m])", "legendFormat": "rx drop {{instance}}/{{device}}", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(node_network_transmit_drop_total{instance=~\"$host\", device!=\"lo\"}[5m])", "legendFormat": "tx drop {{instance}}/{{device}}", "refId": "D" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Conntrack + TCP established connections",
      "description": "node_nf_conntrack_entries vs node_nf_conntrack_entries_limit, and node_netstat_Tcp_CurrEstab -- relay under heavy WebRTC/TCP fallback load can exhaust the conntrack table before CPU/memory look stressed.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 52 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_nf_conntrack_entries{instance=~\"$host\"}", "legendFormat": "conntrack used {{instance}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_nf_conntrack_entries_limit{instance=~\"$host\"}", "legendFormat": "conntrack limit {{instance}}", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_netstat_Tcp_CurrEstab{instance=~\"$host\"}", "legendFormat": "tcp established {{instance}}", "refId": "C" }
      ]
    }
  ]
}
